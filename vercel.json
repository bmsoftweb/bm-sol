{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/suporte",
      "destination": "/index.html"
    },
    {
      "source": "/tela-remota",
      "destination": "/index.html"
    },
    {
      "source": "/tecnico",
      "destination": "/index.html"
    }
  ],
  "regions": ["gru1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "memory": 1024
    }
  }
}
